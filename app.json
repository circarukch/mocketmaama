{
  "expo": {
    "name": "Mocket Maama",
    "slug": "mocket-maama",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.mocketmaama.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.mocketmaama.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Mocket Maama",
      "shortName": "Mocket Maama",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF",
      "lang": "en-IN"
    },
    "scheme": "mocketmaama",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Learn to trade Indian stocks with free virtual tokens."
  }
}
